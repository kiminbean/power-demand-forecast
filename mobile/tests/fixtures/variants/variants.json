    "/api/v1/market-status": "../round0/_api_v1_market-status.json",
    "/api/v1/bidding/optimized-segments": "../round0/_api_v1_bidding_optimized-segments_capacity_mw_50_risk_level_moderate.json",
    "/api/v1/realtime-status": "../f0-live/_api_v1_realtime-status.json"
  },
